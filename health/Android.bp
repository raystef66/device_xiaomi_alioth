// SPDX-License-Identifier: Apache-2.0
cc_defaults {
    name: "alioth_health_defaults",
    relative_install_path: "hw",
    vendor: true,
    recovery_available: true,
    defaults: ["libhealth_aidl_impl_user"],
    static_libs: ["libhealth_aidl_impl"],
    include_dirs: [
        "system/core/healthd",
        "system/core/healthd/include",
        "system/core/healthd/include_charger",
    ],
    srcs: ["main.cpp", "AliothHealth.cpp"],
    cflags: ["-Wall", "-Werror"],
    vintf_fragments: ["android.hardware.health-service.alioth.xml"],
}

cc_binary {
    name: "android.hardware.health-service.alioth",
    defaults: ["alioth_health_defaults"],
    recovery: false,
    init_rc: ["android.hardware.health-service.alioth.rc"],
    overrides: ["android.hardware.health-service.qti", "charger"],
}

cc_binary {
    name: "android.hardware.health-service.alioth_recovery",
    defaults: ["alioth_health_defaults"],
    vendor: false,
    recovery: true,
    init_rc: ["android.hardware.health-service.alioth_recovery.rc"],
    overrides: ["android.hardware.health-service.qti_recovery", "charger.recovery"],
}
